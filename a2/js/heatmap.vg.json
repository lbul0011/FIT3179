{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "data": {
    "url": "data/metro_train_station/metro_train_station.csv"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2018,
      "bind": {
        "input": "range",
        "min": 2018,
        "max": 2022,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.Year == selectedYear"
    },
    {
      "filter": "datum.Line !== 'City Loop'"
    },
    {
      "fold": [
        "Pax_AM_peak",
        "Pax_interpeak",
        "Pax_PM_peak",
        "Pax_PM_late",
        "Pax_pre_AM_peak"
      ],
      "as": ["Time_Band", "Patronage"]
    },
    {
      "aggregate": [
        {"op": "average", "field": "Patronage", "as": "Avg_Patronage"}
      ],
      "groupby": ["Line", "Time_Band"]
    }
  ],
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "Time_Band",
      "type": "ordinal",
      "title": "Time Band",
      "sort": [
        "Pax_pre_AM_peak",
        "Pax_AM_peak",
        "Pax_interpeak",
        "Pax_PM_peak",
        "Pax_PM_late"
      ],
      "axis": {
        "labelExpr": "datum.label == 'Pax_pre_AM_peak' ? 'Pre AM' : datum.label == 'Pax_AM_peak' ? 'AM Peak' : datum.label == 'Pax_interpeak' ? 'Interpeak' : datum.label == 'Pax_PM_peak' ? 'PM Peak' : 'PM Late'",
        "labelAngle":45
      }
    },
    "y": {
      "field": "Line",
      "type": "nominal",
      "title": "Train Line"
    },
    "color": {
      "field": "Avg_Patronage",
      "type": "quantitative",
      "title": "Avg Pax Entries",
      "scale": {"range": "heatmap"}
      
    },
    "tooltip": [
      {"field": "Line", "title": "Train Line"},
      {"field": "Time_Band", "title": "Time Band"},
      {"field": "Avg_Patronage", "title": "Avg Pax", "format": ",.0f"}
    ]
  },
  "title": {
    "text": [
      "Average Weekday Patronage by Train Line and Time Band",
      "(Excluding City Loop stations)"
    ]
  }
}